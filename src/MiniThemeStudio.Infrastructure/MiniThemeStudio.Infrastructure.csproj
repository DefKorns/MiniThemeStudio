<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MiniThemeStudio.Core\MiniThemeStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MiniThemeStudio.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.SquashFs" Version="1.0.90" />
    <PackageReference Include="SharpCompress" Version="0.50.5" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Firmware\firmwares.json" LogicalName="MiniThemeStudio.Firmware.firmwares.json" />
    <EmbeddedResource Include="Fonts\Charsets\*.txt" LogicalName="MiniThemeStudio.Fonts.Charsets.%(Filename).txt" />
    <EmbeddedResource Include="Fonts\Resources\*.ttf" LogicalName="MiniThemeStudio.Fonts.Resources.%(Filename).ttf" />
    <None Include="Fonts\Resources\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="licenses\%(Filename).txt" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
