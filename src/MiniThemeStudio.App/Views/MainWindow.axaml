<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MiniThemeStudio.App.ViewModels"
        xmlns:themes="using:MiniThemeStudio.Core.Themes"
        xmlns:scenes="using:MiniThemeStudio.Core.Scenes"
        xmlns:fonts="using:MiniThemeStudio.Core.Fonts"
        xmlns:audio="using:MiniThemeStudio.Core.Audio"
        xmlns:lucide="using:Lucide.Avalonia"
        xmlns:controls="using:MiniThemeStudio.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="780"
        x:Class="MiniThemeStudio.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app-icon.ico"
        Title="Mini Theme Studio"
        Width="1250" Height="780"
        MinWidth="1250" MinHeight="780"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI, Ubuntu, sans-serif">

  <Window.DataTemplates>
    <!-- play / pause, the time slider and the time, for every animation preview -->
    <DataTemplate DataType="vm:AnimationClock">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <ToggleButton Padding="10,5" IsChecked="{Binding IsPlaying, Mode=OneWay}" Command="{Binding TogglePlayCommand}" ToolTip.Tip="Play in a loop, or pause">
          <Panel>
            <lucide:LucideIcon Kind="Play" Size="14" IsVisible="{Binding !IsPlaying}" />
            <lucide:LucideIcon Kind="Pause" Size="14" IsVisible="{Binding IsPlaying}" />
          </Panel>
        </ToggleButton>
        <Slider Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Time}" IsEnabled="{Binding HasDuration}" />
        <TextBlock Grid.Column="2" MinWidth="90" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding TimeText}" />
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="56,*,28" ColumnDefinitions="56,*">
    <!-- Left Navigation Bar -->
    <Border Grid.RowSpan="3" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="56,*,Auto">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Georgia, serif" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Text="M" />
        <StackPanel Grid.Row="1" Margin="8,14" Spacing="8">
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Command="{Binding CreateThemeCommand}" ToolTip.Tip="Create new theme">
            <lucide:LucideIcon Kind="Plus" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Command="{Binding OpenThemeCommand}" ToolTip.Tip="Edit existing theme">
            <lucide:LucideIcon Kind="FolderOpen" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Command="{Binding ShowSavedDraftsCommand}" ToolTip.Tip="Saved drafts">
            <lucide:LucideIcon Kind="FolderClock" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Command="{Binding ManageBasesCommand}" ToolTip.Tip="Manage Base Firmwares">
            <lucide:LucideIcon Kind="Database" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
          <Button Width="40" Height="40" Padding="0" Background="{DynamicResource SidebarSelectedBrush}" ToolTip.Tip="Workspace" IsVisible="{Binding IsThemeOpen}">
            <lucide:LucideIcon Kind="LayoutDashboard" Size="20" Foreground="{DynamicResource AccentBrush}" />
          </Button>
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Command="{Binding ReturnHomeCommand}" ToolTip.Tip="Discard draft and return to start" IsVisible="{Binding IsThemeOpen}">
            <lucide:LucideIcon Kind="House" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="8,0,8,12" Spacing="8">
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Command="{Binding ShowSettingsCommand}" ToolTip.Tip="Settings">
            <lucide:LucideIcon Kind="Settings" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
          <Button Width="40" Height="40" Padding="0" Background="Transparent" Click="ThemeMode_Click" ToolTip.Tip="Toggle dark mode">
            <lucide:LucideIcon x:Name="ThemeModeIcon" Kind="Moon" Size="20" Foreground="{DynamicResource HeaderMutedBrush}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Header Bar -->
    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="20,0">
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextBrush}" FontFamily="Georgia, serif" FontSize="18" FontWeight="SemiBold" Text="Mini Theme Studio" />
        <Grid Grid.Column="1" Margin="24,0,16,0" HorizontalAlignment="Left" VerticalAlignment="Center" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" ClipToBounds="True" IsVisible="{Binding IsThemeOpen}">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource HeaderTextBrush}" Text="{Binding ThemeName}" TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding ThemeName}" />
          <Border Grid.Column="1" Padding="6,2" Background="{DynamicResource SidebarSelectedBrush}" CornerRadius="4">
            <TextBlock FontSize="11" Foreground="{DynamicResource HeaderMutedBrush}" Text="{Binding Author, StringFormat='by {0}'}" />
          </Border>
          <Button Grid.Column="2" Padding="8,2" Background="{DynamicResource SidebarSelectedBrush}" CornerRadius="4" Command="{Binding ChangeBaseCommand}" ToolTip.Tip="Console and Base used to edit this theme">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Gamepad2" Size="14" Foreground="{DynamicResource HeaderMutedBrush}" />
              <TextBlock FontSize="11" Foreground="{DynamicResource HeaderMutedBrush}" Text="{Binding CurrentBaseLabel}" />
            </StackPanel>
          </Button>
          <Border Grid.Column="3" Padding="6,2" Background="{DynamicResource DialogWarningBrush}" CornerRadius="4" IsVisible="{Binding ShowUnsavedChangesBadge}">
            <TextBlock FontSize="11" FontWeight="Bold" Foreground="#151515" Text="Unsaved changes" />
          </Border>
          <Border Grid.Column="3" Padding="6,2" Background="{DynamicResource SidebarSelectedBrush}" CornerRadius="4" IsVisible="{Binding ShowDraftSavedBadge}"
                  ToolTip.Tip="The changes are kept in a saved draft; Save writes them to the theme">
            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Draft saved" />
          </Border>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsThemeOpen}">
          <ToggleSwitch VerticalAlignment="Center" IsChecked="{Binding Mode.IsAdvanced}" OnContent="Advanced" OffContent="Simple"
                        ToolTip.Tip="Simple: sprites, wallpapers, character frames, fonts and music. Advanced adds scenes, colours, scrolling layers and character animations" />
          <Button Padding="12,6" Background="Transparent" Command="{Binding RunValidationCommand}" ToolTip.Tip="Validate theme integrity">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Check" Size="16" />
              <TextBlock Text="Validate" />
            </StackPanel>
          </Button>
          <Button Padding="12,6" Background="Transparent" Command="{Binding ExportPackageCommand}" ToolTip.Tip="Validate and export the changed files as a .tar.gz theme package">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Package" Size="16" />
              <TextBlock Text="Export .tar.gz" />
            </StackPanel>
          </Button>
          <Button Padding="12,6" Background="Transparent" Command="{Binding SaveDraftCommand}" ToolTip.Tip="Keep this work in progress and resume it later">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <lucide:LucideIcon Kind="Bookmark" Size="16" />
              <TextBlock Text="Save draft" />
            </StackPanel>
          </Button>
          <Button Padding="16,6" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" IsEnabled="{Binding HasUnsavedChanges}" Command="{Binding SaveThemeCommand}" Content="Save" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Home / Start View -->
    <Grid Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsHomeVisible}">
      <Grid Width="880" HorizontalAlignment="Center" VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*">
        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,32" Spacing="6">
          <TextBlock FontFamily="Georgia, serif" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Mini Theme Studio" />
          <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Choose an action to start building or editing retro themes." />
          <Button Margin="0,6,0,0" Padding="0" Background="Transparent" Foreground="{DynamicResource AccentBrush}" Command="{Binding ShowSavedDraftsCommand}" Content="Resume a saved draft..." />
        </StackPanel>

        <Button Grid.Row="1" Margin="0,0,8,0" Padding="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Command="{Binding CreateThemeCommand}">
          <StackPanel Spacing="10">
            <lucide:LucideIcon Kind="Plus" Size="28" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock FontFamily="Georgia, serif" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Create theme" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Clone a base stock UI into a new theme project." TextWrapping="Wrap" />
          </StackPanel>
        </Button>

        <Button Grid.Row="1" Grid.Column="1" Margin="4,0,4,0" Padding="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Command="{Binding OpenThemeCommand}">
          <StackPanel Spacing="10">
            <lucide:LucideIcon Kind="FolderOpen" Size="28" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock FontFamily="Georgia, serif" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Edit existing" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Open an existing theme folder from disk." TextWrapping="Wrap" />
          </StackPanel>
        </Button>

        <Button Grid.Row="1" Grid.Column="2" Margin="8,0,0,0" Padding="20" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Command="{Binding ManageBasesCommand}">
          <StackPanel Spacing="10">
            <lucide:LucideIcon Kind="Database" Size="28" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock FontFamily="Georgia, serif" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Base firmwares" />
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Import .tar / .tar.gz archives or extracted folders." TextWrapping="Wrap" />
          </StackPanel>
        </Button>
      </Grid>
    </Grid>

    <!-- Theme Workspace View -->
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Grid.Column="1" IsVisible="{Binding IsThemeOpen}" SelectedIndex="{Binding SelectedTabIndex}">
      <!-- TAB 1: PACKED ATLAS SPRITES -->
      <TabItem Header="Sprites">
        <Grid ColumnDefinitions="270,*,320" Margin="16,12" DataContext="{Binding SpritesTab}" x:DataType="vm:SpritesViewModel">
          <!-- Atlas and sprite list -->
          <Border Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Margin="12" Spacing="8">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Atlases}" SelectedItem="{Binding SelectedAtlas}" ToolTip.Tip="Sprite atlas">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="themes:TextureAtlas">
                      <TextBlock>
                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                        <Run Text="{Binding Sprites.Count, StringFormat=' ({0} sprites)'}" />
                      </TextBlock>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Height="36" Watermark="Search sprites by name..." Text="{Binding SpriteSearchText}" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding AtlasSummary}" />
                  <TextBlock Grid.Column="1" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding FilteredSprites.Count, StringFormat='{}{0} matching'}" />
                </Grid>
              </StackPanel>

              <ListBox Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding FilteredSprites}" SelectedItem="{Binding SelectedSprite}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="Padding" Value="8,4" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="themes:SpriteRegion">
                    <Grid Margin="2" ColumnDefinitions="*,Auto">
                      <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}">
                        <Run Text="{Binding Frame.Width}" />
                        <Run Text="×" />
                        <Run Text="{Binding Frame.Height}" />
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- Visual atlas -->
          <Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="12,8" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding #AtlasCanvas.HoveredSprite.Name, FallbackValue='Click a region to select a sprite'}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                  <Button Padding="6,2" Content="1x" Click="AtlasZoom1x_Click" ToolTip.Tip="Atlas at 100%" />
                  <Button Padding="6,2" Content="2x" Click="AtlasZoom2x_Click" ToolTip.Tip="Atlas at 200%" />
                  <Button Padding="6,2" Content="3x" Click="AtlasZoom3x_Click" ToolTip.Tip="Atlas at 300%" />
                </StackPanel>
              </Grid>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <controls:AtlasView x:Name="AtlasCanvas" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Sprites="{Binding Sprites}" SelectedSprite="{Binding SelectedSprite}" />
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Sprite Preview and Controls Panel -->
          <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer>
              <StackPanel Margin="20" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Sprite Preview" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Button Padding="6,2" Content="1x" Click="Zoom1x_Click" ToolTip.Tip="100% Zoom" />
                    <Button Padding="6,2" Content="2x" Click="Zoom2x_Click" ToolTip.Tip="200% Zoom" />
                    <Button Padding="6,2" Content="4x" Click="Zoom4x_Click" ToolTip.Tip="400% Zoom" />
                    <Button Padding="6,2" Content="Fit" Click="ZoomFit_Click" ToolTip.Tip="Fit frame" />
                  </StackPanel>
                </Grid>

                <Border Height="240" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Image x:Name="SpritePreviewImage" Margin="12" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                </Border>

                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedSprite.Name}" TextWrapping="Wrap" />

                <Grid ColumnDefinitions="*,*" Margin="0,4">
                  <Button Margin="0,0,4,0" Padding="12,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Command="{Binding ReplaceSpriteCommand}" Content="Replace PNG" />
                  <Button Grid.Column="1" Margin="4,0,0,0" Padding="12,8" HorizontalAlignment="Stretch" Command="{Binding ExportSpriteCommand}" Content="Export PNG" />
                </Grid>

                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="FRAME &amp; POSITION" />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Dimensions" />
                  <TextBlock Grid.Column="1">
                    <Run Text="{Binding SelectedSprite.Frame.Width}" />
                    <Run Text="×" />
                    <Run Text="{Binding SelectedSprite.Frame.Height}" />
                  </TextBlock>
                  <TextBlock Grid.Row="1" Foreground="{DynamicResource SecondaryTextBrush}" Text="Offset (X, Y)" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SelectedSprite.Frame.X}" />
                    <TextBlock Text="," />
                    <TextBlock Text="{Binding SelectedSprite.Frame.Y}" />
                  </StackPanel>
                  <TextBlock Grid.Row="2" Foreground="{DynamicResource SecondaryTextBrush}" Text="Pivot" />
                  <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding SelectedSprite.Pivot.X}" />
                    <TextBlock Text="," />
                    <TextBlock Text="{Binding SelectedSprite.Pivot.Y}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 2: WALLPAPERS -->
      <TabItem Header="Wallpapers">
        <Grid ColumnDefinitions="*,380" Margin="16,12" DataContext="{Binding WallpapersTab}" x:DataType="vm:WallpapersViewModel">
          <!-- the NES and Famicom background: colours and the white pictures a script draws it with -->
          <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,360" IsVisible="{Binding HasPixelBackground}"
                DataContext="{Binding PixelBackground}" x:DataType="vm:PixelBackgroundViewModel">
            <Border Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
              <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Background pictures" />
                <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="This console draws its background with a script: patterns of dots, the small Mario and Luigi and the transitions, tinted with the colours on the right. The pictures are white because the colours are added on the console; they are shown here over the background colour." />
                <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
                  <ItemsControl ItemsSource="{Binding Images}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:BackgroundImageRow">
                        <Border Margin="0,0,0,10" Padding="10" CornerRadius="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                          <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="12">
                            <Border Height="90" CornerRadius="4" Background="{Binding $parent[ItemsControl].((vm:PixelBackgroundViewModel)DataContext).BackgroundBrush}">
                              <controls:FileImage Margin="6" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" FilePath="{Binding ImagePath}" Revision="{Binding Revision}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                              <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Label}" />
                              <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding Description}" />
                              <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SizeText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                              <Button Padding="12,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Replace PNG..."
                                      Command="{Binding $parent[ItemsControl].((vm:PixelBackgroundViewModel)DataContext).ReplaceImageCommand}" CommandParameter="{Binding}" />
                              <Button Padding="12,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Export PNG..."
                                      Command="{Binding $parent[ItemsControl].((vm:PixelBackgroundViewModel)DataContext).ExportImageCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
              <StackPanel Margin="20" Spacing="14">
                <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Background Colours" />
                <ItemsControl ItemsSource="{Binding Colors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackgroundColorRow">
                      <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Label}" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ColorName}" />
                        </StackPanel>
                        <ColorPicker Grid.Column="1" Color="{Binding Color}" IsAlphaEnabled="False" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"
                          FontWeight="SemiBold" Command="{Binding ApplyColorsCommand}" Content="Apply" />
                  <Button Grid.Column="1" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding ResetColorsCommand}" Content="Discard" />
                </Grid>
                <Button Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding RestoreBaseColorsCommand}" Content="Restore Base colours"
                        ToolTip.Tip="Write back the colours of the Base" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="The colours are written to the theme's colour palette (scripts/colors_*.lua), for every region that has them." />
              </StackPanel>
            </Border>
          </Grid>

          <!-- the list takes the whole column when the Base has no scrolling background -->
          <DockPanel Margin="0,0,12,0" IsVisible="{Binding HasWallpaperImages}">
          <Border DockPanel.Dock="Top" Height="390" Margin="0,0,0,12" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                  DataContext="{Binding Parallax}" x:DataType="vm:ParallaxViewModel" IsVisible="{Binding HasBackgrounds}">
            <Grid RowDefinitions="Auto,*,Auto">
              <Grid Margin="12,8" ColumnDefinitions="Auto,*">
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Background as the console plays it" />
                <ContentControl Grid.Column="1" Margin="16,0,0,0" Content="{Binding Clock}" />
              </Grid>
              <controls:ScenePreview Grid.Row="1" Margin="12,0"
                                     Root="{Binding PreviewRoot}"
                                     BranchPath="{Binding PreviewBranchPath}"
                                     SelectedPath="{Binding PreviewSelectedPath}"
                                     Images="{Binding Images}" />
              <TextBlock Grid.Row="2" Margin="12,8" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                         Text="The framed layer is the one selected on the right; click a layer here to select it. A new speed shows here before you apply it." />
            </Grid>
          </Border>
          <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Margin="16,10" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Wallpaper images" />
              <ListBox Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding Wallpapers}" SelectedItem="{Binding SelectedWallpaper}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="themes:WallpaperAsset">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                      <Border Width="32" Height="32" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4" Margin="0,0,12,0">
                        <lucide:LucideIcon Kind="Image" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding DisplayName}" />
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Not drawn by any scene" IsVisible="{Binding !UsedBy.Count}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Width, StringFormat='{}{0} × '}" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Height, StringFormat='{}{0} px'}" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="(Inherited from Base)" IsVisible="{Binding IsFromBaseUi}" />
                        </StackPanel>
                      </StackPanel>
                      <lucide:LucideIcon Grid.Column="2" Kind="ChevronRight" Size="16" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          </DockPanel>

          <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding HasWallpaperImages}">
            <ScrollViewer>
              <StackPanel Margin="20" Spacing="14">
                <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Wallpaper Image" />
                <Border Height="150" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <controls:FileImage Margin="8" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" FilePath="{Binding SelectedWallpaper.ImagePath}" Revision="{Binding PreviewRevision}" />
                </Border>
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedWallpaper.DisplayName}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedWallpaper.UsageText}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,*" Margin="0,4">
                  <Button Margin="0,0,4,0" Padding="12,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Command="{Binding ReplaceWallpaperCommand}" Content="Replace PNG" />
                  <Button Grid.Column="1" Margin="4,0,0,0" Padding="12,8" HorizontalAlignment="Stretch" Command="{Binding ExportWallpaperCommand}" Content="Export PNG" />
                </Grid>
                <Button Padding="12,8" HorizontalAlignment="Stretch" Command="{Binding DeleteWallpaperCommand}" Content="{Binding DeleteWallpaperText}" IsVisible="{Binding Mode.IsAdvanced}"
                        ToolTip.Tip="Only the theme's own images: an image a scene still draws is kept (remove its layer first)" />
                <Border Height="1" Background="{DynamicResource BorderBrush}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Wallpapers define the main background, near foreground parallax layer, and far distant layer. Dimensions are automatically preserved or updated in JSON." TextWrapping="Wrap" />

                <!-- Scrolling layers -->
                <StackPanel Spacing="10" Margin="0,8,0,0" IsVisible="{Binding $parent[ScrollViewer].((vm:WallpapersViewModel)DataContext).Mode.IsAdvanced}" DataContext="{Binding Parallax}" x:DataType="vm:ParallaxViewModel">
                  <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Scrolling Layers" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasBackgrounds}"
                             Text="This Base draws its background from a script, so its layers cannot be changed here." />
                  <StackPanel Spacing="10" IsVisible="{Binding HasBackgrounds}">
                    <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Backgrounds}" SelectedItem="{Binding SelectedBackground}" ToolTip.Tip="The background and the animation that scrolls it">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="scenes:ParallaxBackground">
                          <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding CycleText}" />
                    <ListBox MaxHeight="180" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ParallaxLayerRow">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Detail}" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid ColumnDefinitions="110,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4" IsEnabled="{Binding HasSelectedLayer}">
                      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Speed" />
                      <NumericUpDown Grid.Column="1" Value="{Binding LayerLoops}" Increment="1" FormatString="0" Minimum="-16" Maximum="16"
                                     ToolTip.Tip="Loops per cycle: how many times the layer slides by its own width. Negative scrolls the other way, 0 stops it" />
                      <Button Grid.Column="2" Padding="10,6" Command="{Binding ApplySpeedCommand}" Content="Apply" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SpeedText}" />
                    </Grid>
                    <Button Padding="10,6" HorizontalAlignment="Stretch" Command="{Binding RemoveLayerCommand}" Content="Remove layer..." />

                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="NEW LAYER" />
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Name" />
                      <TextBox Grid.Column="1" Text="{Binding NewLayerName}" />
                      <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Y" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding NewLayerY}" Increment="1" FormatString="0" ToolTip.Tip="Pixels above the centre of the screen: Y points up" />
                      <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Layer" />
                      <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding NewLayerZIndex}" Increment="1" FormatString="0" ToolTip.Tip="Higher layers are drawn over lower ones: the far wall is -1, the near wall 0" />
                      <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Scale" />
                      <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding NewLayerScale}" Increment="1" FormatString="0" Minimum="1" Maximum="8" ToolTip.Tip="Screen pixels per image pixel: the console's layers use 3" />
                      <TextBlock Grid.Row="4" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Loops per cycle" />
                      <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding NewLayerLoops}" Increment="1" FormatString="0" Minimum="-16" Maximum="16" />
                    </Grid>
                    <Button Padding="10,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                            Command="{Binding AddLayerCommand}" Content="Choose PNG and add layer..."
                            ToolTip.Tip="The image is repeated side by side until it covers the screen, so it scrolls without a seam" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 3: SCENES -->
      <TabItem Header="Scenes" IsVisible="{Binding Mode.IsAdvanced}">
        <Grid ColumnDefinitions="290,*,320" Margin="16,12" DataContext="{Binding ScenesTab}" x:DataType="vm:ScenesViewModel">
          <!-- Scene and node tree -->
          <Border Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
              <StackPanel Margin="12" Spacing="8">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SceneResources}" SelectedItem="{Binding SelectedSceneResource}" ToolTip.Tip="Scene file" />
                <TextBox Height="36" Watermark="Search nodes by name..." Text="{Binding SceneSearchText}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                  <Button Padding="6,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding AddImageCommand}" Content="Add image..."
                          ToolTip.Tip="Adds a PNG as a new image node: inside the selected group, or next to the selected image" />
                  <Button Grid.Column="1" Padding="6,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DuplicateNodeCommand}" Content="Duplicate"
                          ToolTip.Tip="Copies the selected node and everything inside it" />
                  <Button Grid.Column="2" Padding="6,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Command="{Binding DeleteNodeCommand}" Content="Delete"
                          ToolTip.Tip="Removes the selected node and everything inside it" />
                </Grid>
              </StackPanel>

              <ListBox Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding SceneRows}" SelectedItem="{Binding SelectedSceneRow}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="6,3" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SceneTreeRow">
                    <Grid Margin="{Binding Indent}" ColumnDefinitions="*,Auto" Opacity="{Binding Opacity}">
                      <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Detail}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- Preview -->
          <Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <StackPanel Margin="12,8" Orientation="Horizontal" Spacing="16">
                <CheckBox IsChecked="{Binding IsolateSceneBranch}" Content="Only the selected branch" ToolTip.Tip="Draw only the menu or background the selected node belongs to" />
                <CheckBox IsChecked="{Binding ShowHiddenSceneNodes}" Content="Show hidden nodes" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="12,0,12,8" ColumnDefinitions="240,Auto,*" ColumnSpacing="8">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding SceneAnimations}" SelectedItem="{Binding SelectedAnimation}" PlaceholderText="Play an animation..."
                          ToolTip.Tip="The animations whose nodes are all in this scene; scripts start them on the console">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="scenes:SceneAnimationBinding">
                      <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="1" Padding="10,5" Command="{Binding StopAnimationCommand}" ToolTip.Tip="Back to the scene as it is saved">
                  <lucide:LucideIcon Kind="Square" Size="14" />
                </Button>
                <ContentControl Grid.Column="2" Content="{Binding Clock}" />
              </Grid>
              <controls:ScenePreview Grid.Row="2" Margin="12,0"
                                     Root="{Binding PreviewRoot}"
                                     SelectedPath="{Binding SelectedScenePath}"
                                     BranchPath="{Binding PreviewBranchPath}"
                                     ShowHidden="{Binding ShowHiddenSceneNodes}"
                                     Images="{Binding SceneImages}"
                                     MoveCommand="{Binding MoveNodeCommand}" />
              <TextBlock Grid.Row="3" Margin="12,8" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                         Text="Click an image to select its node and drag it to move it; drag inside a selected group to move the whole group. This is the layout saved in the scene; scripts and animations can still move, show or hide nodes on the console." />
            </Grid>
          </Border>

          <!-- Node properties -->
          <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer>
              <StackPanel Margin="20" Spacing="12">
                <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Node" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedSceneNodeSummary}" TextWrapping="Wrap" />

                <StackPanel Spacing="10" IsEnabled="{Binding HasSelectedSceneNode}">
                  <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Name" />
                    <TextBox Grid.Column="1" Text="{Binding SceneNodeName}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="X" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SceneNodeX}" Increment="1" FormatString="0.##" ToolTip.Tip="Pixels to the right of the parent (the screen centre for top nodes)" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Y" />
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SceneNodeY}" Increment="1" FormatString="0.##" ToolTip.Tip="Pixels above the parent: Y points up" />
                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Layer" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding SceneNodeZIndex}" Increment="1" FormatString="0" ToolTip.Tip="zIndex: among siblings, higher layers are drawn over lower ones" />
                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding SceneNodeVisible}" Content="Visible" />
                  </Grid>

                  <StackPanel Spacing="10" IsVisible="{Binding SelectedNodeDrawsImage}">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" />
                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="IMAGE" />
                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Width" />
                      <NumericUpDown Grid.Column="1" Value="{Binding SceneNodeWidth}" Minimum="0" Increment="1" FormatString="0.##" ToolTip.Tip="Drawn width in pixels" />
                      <TextBlock Grid.Row="1" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Height" />
                      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SceneNodeHeight}" Minimum="0" Increment="1" FormatString="0.##" ToolTip.Tip="Drawn height in pixels" />
                      <TextBlock Grid.Row="2" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Texture" IsVisible="{Binding SelectedNodeIsTexture}" />
                      <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" IsVisible="{Binding SelectedNodeIsTexture}"
                                ItemsSource="{Binding SceneTextureChoices}" SelectedItem="{Binding SceneNodeTexture}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:SceneTextureChoice">
                            <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding RelativePath}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </Grid>
                    <Button Padding="10,6" HorizontalAlignment="Stretch" IsVisible="{Binding SelectedNodeIsTexture}" Command="{Binding ReplaceImageCommand}" Content="Replace PNG..."
                            ToolTip.Tip="Replaces the image file: every node that uses this texture changes" />
                    <Button Padding="10,6" HorizontalAlignment="Stretch" IsVisible="{Binding SelectedNodeIsSprite}" Command="{Binding EditSpriteCommand}" Content="Edit sprite in Sprites tab" />
                  </StackPanel>

                  <Border Height="1" Background="{DynamicResource BorderBrush}" />
                  <Grid ColumnDefinitions="*,*">
                    <Button Margin="0,0,4,0" Padding="10,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Command="{Binding ApplyNodeChangesCommand}" Content="Apply" />
                    <Button Grid.Column="1" Margin="4,0,0,0" Padding="10,8" HorizontalAlignment="Stretch" Command="{Binding ResetSceneNodeFieldsCommand}" Content="Discard" />
                  </Grid>
                  <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                             Text="Changes are written to this theme's copy of the scene; the Base is never modified." />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- CHARACTERS -->
      <TabItem Header="Characters">
        <Grid DataContext="{Binding CharactersTab}" x:DataType="vm:CharactersViewModel" ColumnDefinitions="Auto,*,320" Margin="16,12">
          <!-- the NES and Famicom UIs draw their characters from sheets: one row at a time, like a SNES character -->
          <Grid Grid.ColumnSpan="3" ColumnDefinitions="*,320" IsVisible="{Binding ShowSheet}">
            <Border Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
              <Grid RowDefinitions="Auto,Auto,*" Margin="12">
                <Grid ColumnDefinitions="Auto,220,*,Auto" ColumnSpacing="12">
                  <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Frames of" />
                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding SheetGroups}" SelectedItem="{Binding SelectedSheetGroup}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:SheetGroupView">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="3" Padding="10,6" Content="Import from a sprite sheet..."
                          Command="{Binding ImportRowCommand}" CommandParameter="{Binding SelectedSheetGroup.Row}"
                          ToolTip.Tip="Open any sprite sheet and pick these pictures on it, in order" />
                </Grid>
                <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="Replace each picture with a PNG, or pick them all on a sprite sheet. A new picture can fill the room of its frame and stands where the old one stood." />
                <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
                  <ItemsControl ItemsSource="{Binding SelectedSheetGroup.Row.Frames}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SheetFrameView">
                        <Border Width="120" Padding="8" CornerRadius="4" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                          <StackPanel Spacing="4">
                            <Image Height="72" Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SizeText}" />
                            <Button Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Replace..."
                                    Command="{Binding $parent[ScrollViewer].((vm:CharactersViewModel)DataContext).ReplaceSheetFrameCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
              <StackPanel Margin="20" Spacing="14">
                <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedSheetGroup.Sheet.Title}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Text="{Binding SelectedSheetGroup.Sheet.Description}" />
                <Border Height="200" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Image Margin="12" Source="{Binding SelectedSheetGroup.Sheet.Image}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Replace sheet..."
                          Command="{Binding ReplaceSheetCommand}" CommandParameter="{Binding SelectedSheetGroup.Sheet}"
                          ToolTip.Tip="A whole sheet edited elsewhere, the same size as this one" />
                  <Button Grid.Column="1" Padding="12,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Export sheet..."
                          Command="{Binding ExportSheetCommand}" CommandParameter="{Binding SelectedSheetGroup.Sheet}"
                          ToolTip.Tip="Save the sheet to edit it in an image editor" />
                </Grid>
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                           Text="An edited sheet keeps every picture in its place: the console cuts them at fixed places." />
              </StackPanel>
            </Border>
          </Grid>

          <Border Width="260" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding ShowAdvancedFrames}">
            <Grid RowDefinitions="Auto,*" Margin="12">
              <StackPanel Spacing="8">
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CharacterSizeText}" />
              </StackPanel>
              <ListBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding CharacterAnimations}" SelectedItem="{Binding SelectedAnimation}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="themes:CharacterAnimation">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                      <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Duration, StringFormat='{}{0:0.###} s'}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding ShowSimpleFrames}">
            <Grid RowDefinitions="Auto,Auto,*" Margin="12">
              <Grid ColumnDefinitions="Auto,200,*" ColumnSpacing="12">
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Frames of" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding CharacterSizeText}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                         Text="Replace each frame with a PNG of the same size. The animations keep using the same frames, so the character keeps moving as on the official theme." />
              <ScrollViewer Grid.Row="2" Margin="0,10,0,0">
                <ItemsControl ItemsSource="{Binding CharacterFrames}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CharacterFrameRow">
                      <Border Width="120" Padding="8" CornerRadius="4" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                          <Image Height="72" Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                          <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SizeText}" />
                          <Button Padding="8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Content="Replace..."
                                  Command="{Binding $parent[ItemsControl].((vm:CharactersViewModel)DataContext).ReplaceFrameCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding ShowAdvancedFrames}">
            <Grid RowDefinitions="Auto,*" Margin="12">
              <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Frames (faded frames run after the loop, click to select)" />
              <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                <ListBox x:Name="AnimationFramesList" ItemsSource="{Binding AnimationFrames}" SelectionMode="Multiple,Toggle" Background="Transparent">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnimationFrameView">
                      <Border Width="96" Padding="6" CornerRadius="4" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Opacity="{Binding Opacity}">
                        <StackPanel Spacing="4">
                          <Image Height="64" Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                          <TextBlock FontSize="11" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding TimeText}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" IsVisible="{Binding ShowAnimations}">
            <ScrollViewer>
              <StackPanel Margin="20" Spacing="14">
                <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Animation Preview" />
                <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding CharacterAnimations}" SelectedItem="{Binding SelectedAnimation}" IsVisible="{Binding Mode.IsSimple}"
                          ToolTip.Tip="The animation shown with the current frames">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="themes:CharacterAnimation">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Border Height="220" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <Image x:Name="AnimationPreviewImage" Margin="12" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
                </Border>
                <CheckBox x:Name="MirrorPreviewCheckBox" Content="Preview flipped" IsChecked="{Binding IsPreviewMirrored}" IsCheckedChanged="MirrorPreview_IsCheckedChanged"
                          ToolTip.Tip="Show the animation flipped horizontally without changing any frame" />
                <StackPanel Spacing="14" IsVisible="{Binding Mode.IsAdvanced}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Padding="12,8" Command="{Binding MirrorSelectedFramesCommand}" CommandParameter="{Binding #AnimationFramesList.SelectedItems}" Content="Flip selected"
                          ToolTip.Tip="Flip the pixels of the selected frames horizontally" />
                  <Button Padding="12,8" Command="{Binding MirrorAllFramesCommand}" Content="Flip all frames"
                          ToolTip.Tip="Flip every frame of this animation horizontally, each texture once" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock VerticalAlignment="Center" Text="Frame time (ms)" />
                  <NumericUpDown Width="130" Minimum="10" Maximum="1000" Increment="5" FormatString="0.#" Value="{Binding FrameTimeMilliseconds}" />
                </StackPanel>
                <Button Padding="12,8" HorizontalAlignment="Stretch" Command="{Binding ApplyFrameTimeCommand}" Content="Apply frame time"
                        ToolTip.Tip="Space the loop frames of this animation evenly at this frame time" />
                <Button Padding="12,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                        Command="{Binding ReplaceFramesCommand}" Content="Replace frames from sprite sheet..." />
                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="The loop frames are replaced in place and extra frames are added as new textures. Other animations of the character keep their own frames." />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 4: FONTS -->
      <TabItem Header="Fonts">
        <Grid DataContext="{Binding FontsTab}" x:DataType="vm:FontsViewModel" ColumnDefinitions="300,*,300" Margin="16,12">
          <!-- Column 1: Fonts List -->
          <Border Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto,*">
              <TextBlock Margin="16,12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="UI Fonts (.fnt / .font)" />
              <ListBox Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="fonts:FontAsset">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                      <Border Width="32" Height="32" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4" Margin="0,0,12,0">
                        <lucide:LucideIcon Kind="Type" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding DisplayName}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding GlyphCount, StringFormat='{}{0} glyphs'}" />
                          <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding LineHeight, StringFormat='{}• {0}px height'}" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="(From Base)" IsVisible="{Binding IsFromBaseUi}" />
                        </StackPanel>
                      </StackPanel>
                      <lucide:LucideIcon Grid.Column="2" Kind="ChevronRight" Size="16" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel Margin="16,12,16,12" Spacing="12">
                  <TextBlock FontFamily="Georgia, serif" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Font Properties" />

                  <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedFont.DisplayName}" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedFont.RelativePath}" TextWrapping="Wrap" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding SelectedFont.RolesText, StringFormat='Roles: {0}'}" TextWrapping="Wrap" />

                  <!-- scripts taken from the complete base font of the same role -->
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="EXTRA SCRIPTS" />
                    <WrapPanel>
                      <CheckBox Margin="0,0,12,0" Content="Japanese" IsChecked="{Binding ConvertJapanese}" />
                      <CheckBox Margin="0,0,12,0" Content="Cyrillic" IsChecked="{Binding ConvertCyrillic}" />
                      <CheckBox Content="Greek" IsChecked="{Binding ConvertGreek}" />
                    </WrapPanel>
                  </StackPanel>

                  <!-- Action Buttons: Convert TTF/OTF, Replace PNG, Replace FNT, Export PNG, Export FNT -->
                  <Grid ColumnDefinitions="*,*" Margin="0,4" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="6">
                    <Button Padding="8,8" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold"
                            Command="{Binding ConvertTrueTypeFontCommand}" Content="Convert TTF / OTF..."
                            Grid.ColumnSpan="2" ToolTip.Tip="Convert .ttf, .otf, or .zip directly into console BMFont" />
                    <Button Grid.Row="1" Padding="8,8" HorizontalAlignment="Stretch"
                            Command="{Binding ReplaceTextureCommand}" Content="Replace PNG" ToolTip.Tip="Replace texture art while preserving glyph coordinates" />
                    <Button Grid.Row="1" Grid.Column="1" Padding="8,8" HorizontalAlignment="Stretch"
                            Command="{Binding ExportTextureCommand}" Content="Export PNG" ToolTip.Tip="Export glyph atlas as PNG" />
                    <Button Grid.Row="2" Padding="8,8" HorizontalAlignment="Stretch"
                            Command="{Binding ReplaceFontFileCommand}" Content="Replace .fnt" ToolTip.Tip="Import whole .fnt or .font file" />
                    <Button Grid.Row="2" Grid.Column="1" Padding="8,8" HorizontalAlignment="Stretch"
                            Command="{Binding ExportFontFileCommand}" Content="Export .fnt" ToolTip.Tip="Export .fnt file to disk" />
                  </Grid>

                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <!-- Column 2: Center - Texture Atlas & Rendered Sample Text Preview -->
          <Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14">
              <!-- Rendered Preview Header & Sample Text Input -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Live Text Preview (Rendered from Font)" />
                <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="Pixel-accurate console render" />
              </Grid>

              <TextBox Grid.Row="1" Height="56" AcceptsReturn="True" TextWrapping="Wrap"
                       Watermark="Type sample text to preview font rendering..."
                       Text="{Binding FontSampleText}" Margin="0,0,0,10" />

              <Border Grid.Row="2" Height="140" Margin="0,0,0,14" Background="#18181B" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Image Source="{Binding FontSamplePreview}" Margin="8" Stretch="None" RenderOptions.BitmapInterpolationMode="None" />
                </ScrollViewer>
              </Border>

              <!-- Font Texture Atlas View -->
              <Grid Grid.Row="3" RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                  <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Glyph Texture Atlas" />
                  <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}">
                    <Run Text="{Binding SelectedFont.TextureWidth}" />
                    <Run Text="×" />
                    <Run Text="{Binding SelectedFont.TextureHeight}" />
                    <Run Text="px" />
                  </TextBlock>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding FontTexturePreview}" Margin="8" Stretch="None" RenderOptions.BitmapInterpolationMode="None" />
                  </ScrollViewer>
                </Border>
              </Grid>
            </Grid>
          </Border>

          <!-- Column 3: Font Details, Glyphs List & Actions -->
          <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                <StackPanel Spacing="8">
                  <!-- Glyph Coverage Validation -->
                  <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="GLYPH COVERAGE &amp; C8 RISK" />
                  <Border Padding="10" CornerRadius="4" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="Auto,*">
                        <lucide:LucideIcon Kind="Check" Size="16" Foreground="#10B981" Margin="0,0,6,0" IsVisible="{Binding FontValidation.IsSafeForWesternUi, FallbackValue=false}" />
                        <lucide:LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource DialogWarningBrush}" Margin="0,0,6,0" IsVisible="{Binding !FontValidation.IsSafeForWesternUi, FallbackValue=true}" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="12" Text="{Binding FontValidation.Summary, FallbackValue='Select a font to check'}" TextWrapping="Wrap" />
                      </Grid>
                      <Button Margin="0,6,0,0" Padding="8,6" HorizontalAlignment="Stretch" Content="Fill missing from base"
                              IsVisible="{Binding !FontValidation.IsSafeForWesternUi, FallbackValue=false}"
                              Command="{Binding CompleteFontCommand}" ToolTip.Tip="Add the characters this font lacks from the complete base font of its role" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                  <TextBlock FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="GLYPH TABLE" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding FilteredFontGlyphs.Count, StringFormat='{}{0} glyphs'}" VerticalAlignment="Center" />
                </Grid>
                <TextBox Grid.Row="2" Height="32" Watermark="Filter glyphs (char, code, U+0041)..." Text="{Binding GlyphSearchText}" />

                <ListBox Grid.Row="3" ItemsSource="{Binding FilteredFontGlyphs}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="fonts:FontGlyph">
                      <Grid ColumnDefinitions="32,*,Auto" Margin="0,2">
                        <Border Width="24" Height="24" Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="2">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Character}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                          <TextBlock FontSize="12" Text="{Binding Id, StringFormat='U+{0:X4}'}" />
                          <TextBlock FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Width, StringFormat='{}{0}×'}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="{Binding XAdvance, StringFormat='adv: {0}px'}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Colors" IsVisible="{Binding Mode.IsAdvanced}">
        <Grid ColumnDefinitions="280,*,400" Margin="16,12" DataContext="{Binding ColorsTab}" x:DataType="vm:ColorsViewModel">
          <Border Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Margin="16,12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Palettes (colors_*.lua)" />
              <ListBox Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding Palettes}" SelectedItem="{Binding SelectedPalette}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="10,8" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="themes:ThemePalette">
                    <Grid ColumnDefinitions="Auto,*" Margin="4,2">
                      <Border Width="32" Height="32" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="4" Margin="0,0,12,0">
                        <lucide:LucideIcon Kind="Palette" Size="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Region}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Colors.Count, StringFormat='{}{0} colours'}" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="(From Base)" IsVisible="{Binding IsFromBaseUi}" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Margin="0,0,12,0" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid RowDefinitions="Auto,*">
              <Grid Margin="16,8" ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedPalette.RelativePath}" />
                <CheckBox Grid.Column="1" Content="Show unused" IsChecked="{Binding ShowUnusedColors}"
                          ToolTip.Tip="Colours no scene or script of this UI names; they may be for other consoles or read by the engine itself" />
              </Grid>
              <ListBox Grid.Row="1" Margin="8,0,8,8" ItemsSource="{Binding PaletteColors}" SelectedItem="{Binding SelectedPaletteColor}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteColorRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                      <Border Width="40" Height="24" CornerRadius="4" Margin="0,0,12,0" Background="{Binding Swatch}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Name}" />
                      <TextBlock Grid.Column="2" VerticalAlignment="Center" FontFamily="monospace" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Hex}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="2" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14" Spacing="12">
              <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding SelectedPaletteColor.Name}" />
              <ColorView Color="{Binding EditColor}" IsAlphaEnabled="True" IsColorPaletteVisible="False" />
              <CheckBox IsChecked="{Binding ApplyColorToAllRegions}" Content="Apply to all regions" />
              <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" Command="{Binding ApplyColorCommand}" Content="Apply" />
              <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding ColorUsageSummary}" />
              <ItemsControl ItemsSource="{Binding ColorUsages}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="themes:PaletteColorUsage">
                    <StackPanel Margin="0,0,0,8" Spacing="1">
                      <TextBlock FontFamily="monospace" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding TextKey, TargetNullValue='(no text)'}" />
                      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding NodePath}" />
                      <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding ScenePath}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 5: METADATA & VALIDATION -->
      <TabItem Header="Theme Details &amp; Validation">
        <Grid ColumnDefinitions="*,*" Margin="24">
          <ScrollViewer Margin="0,0,12,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
              <Border Padding="20" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="16">
                  <TextBlock FontFamily="Georgia, serif" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Metadata" />
                  <StackPanel Spacing="6">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Theme Name" />
                    <TextBox Height="36" Text="{Binding ThemeName}" />
                  </StackPanel>
                  <StackPanel Spacing="6">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Author" />
                    <TextBox Height="36" Text="{Binding Author}" />
                  </StackPanel>
                  <CheckBox IsChecked="{Binding RequiresOverlay}" Content="Requires CRT overlay (needs_overlay)" />
                  <Border Height="1" Background="{DynamicResource BorderBrush}" />
                  <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" Text="Draft working location:" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding CurrentDraftPath}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <!-- Background Music (BGM) -->
              <Border DataContext="{Binding AudioTab}" x:DataType="vm:AudioViewModel" Padding="20" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <StackPanel Spacing="14">
                  <TextBlock FontFamily="Georgia, serif" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Background Music (BGM)" />
                  <CheckBox x:Name="IncludeBgmCheckBox" IsChecked="{Binding IncludeBgm}" Content="Include custom BGM in exported theme package" ToolTip.Tip="When unchecked, custom BGM audio is omitted from the exported package, allowing the console to play its original stock audio." />

                  <StackPanel Spacing="14" IsVisible="{Binding IncludeBgm}">
                    <CheckBox x:Name="ConvertBgmCheckBox" IsChecked="{Binding ConvertBgmAudio}" Content="Convert BGM audio to the required format" ToolTip.Tip="When enabled, custom audio (MP3, OGG, FLAC, WAV) is converted into console-compliant PCM 16-bit 44.1 kHz WAV using FFmpeg." />

                    <StackPanel Margin="24,0,0,0" Spacing="8" IsVisible="{Binding ConvertBgmAudio}">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="Export channel format:" />
                      <StackPanel Orientation="Horizontal" Spacing="20">
                        <RadioButton GroupName="BgmChannels" IsChecked="{Binding IsBgmStereo}" Content="Stereo (original audio)" />
                        <RadioButton GroupName="BgmChannels" IsChecked="{Binding IsBgmMono}" Content="Mono (smaller file size)" ToolTip.Tip="Reduces WAV file size by 50% for smaller themes and faster loading." />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>

                  <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" IsVisible="{Binding !IncludeBgm}" Text="Custom BGM is excluded from export. The console will retain its default background music." />

                  <Border Height="1" Background="{DynamicResource BorderBrush}" />

                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="Console BGM Tracks:" />

                  <ItemsControl ItemsSource="{Binding BgmTracks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="audio:BgmTrack">
                        <Border Margin="0,4" Padding="12" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                              <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                              <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding StatusDescription}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                              <Button Padding="10,6" Content="Replace..." Command="{Binding $parent[ItemsControl].((vm:AudioViewModel)DataContext).ReplaceTrackCommand}" CommandParameter="{Binding Name}" ToolTip.Tip="Replace with custom MP3, OGG, FLAC, or WAV" />
                              <Button Padding="10,6" Content="Mute" Command="{Binding $parent[ItemsControl].((vm:AudioViewModel)DataContext).MuteTrackCommand}" CommandParameter="{Binding Name}"
                                      IsVisible="{Binding CanMute}"
                                      IsEnabled="{Binding !IsMuted}"
                                      ToolTip.Tip="Mute boot music with a minimal silent WAV" />
                              <Button Padding="10,6" Content="Convert now" Command="{Binding $parent[ItemsControl].((vm:AudioViewModel)DataContext).ConvertTrackCommand}" CommandParameter="{Binding Name}"
                                      IsVisible="{Binding $parent[ItemsControl].((vm:AudioViewModel)DataContext).ConvertBgmAudio, FallbackValue=false}"
                                      IsEnabled="{Binding ExistsInDraft}" ToolTip.Tip="Convert immediately using FFmpeg" />
                              <Button Padding="10,6" Content="Revert" Command="{Binding $parent[ItemsControl].((vm:AudioViewModel)DataContext).RevertTrackCommand}" CommandParameter="{Binding Name}" IsVisible="{Binding ExistsInDraft}" ToolTip.Tip="Revert to base track / unmute" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Column="1" Margin="12,0,0,0" Padding="20" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"
                  DataContext="{Binding ValidationTab}" x:DataType="vm:ValidationViewModel">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBlock VerticalAlignment="Center" FontFamily="Georgia, serif" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Integrity Validation" />
                <Button Grid.Column="1" Command="{Binding RunCommand}" Padding="12,6" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Content="Re-validate" />
              </Grid>

              <Border Grid.Row="1" Margin="0,0,0,12" Padding="12" CornerRadius="4"
                      Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock FontWeight="SemiBold" Text="{Binding ValidationSummary}" />
              </Border>

              <ListBox Grid.Row="2" ItemsSource="{Binding ValidationIssues}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="themes:ThemeValidationIssue">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                      <lucide:LucideIcon Kind="TriangleAlert" Size="16" Foreground="{DynamicResource DialogWarningBrush}" Margin="0,0,8,0" IsVisible="{Binding !IsError}" />
                      <lucide:LucideIcon Kind="X" Size="16" Foreground="{DynamicResource DialogErrorBrush}" Margin="0,0,8,0" IsVisible="{Binding IsError}" />
                      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Grid.Row="3">
                <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasMissingTextures}">
                  <TextBlock FontWeight="Bold" Foreground="{DynamicResource ErrorTextBrush}" Text="{Binding MissingTextures.Count, StringFormat='Missing textures ({0})'}" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                             Text="These textures are registered in dependencies.json but their image is missing. Provide a PNG and it is saved with the texture id the scenes already use." />
                  <ListBox MaxHeight="160" ItemsSource="{Binding MissingTextures}" SelectedItem="{Binding SelectedMissingTexture}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="themes:MissingTexture">
                        <StackPanel Spacing="2">
                          <TextBlock FontWeight="SemiBold" Text="{Binding ImageRelativePath}" TextTrimming="CharacterEllipsis" />
                          <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding TextureId}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Padding="10,6" HorizontalAlignment="Stretch" Command="{Binding ProvideMissingTextureCommand}" Content="Provide PNG for selected texture" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,12,0,0" IsVisible="{Binding HasUnusedImages}">
                  <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding UnusedImages.Count, StringFormat='Unused images ({0})'}" />
                  <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                             Text="These images are in the theme but no scene draws them, so they only make the package bigger." />
                  <Grid ColumnDefinitions="*,96">
                    <ListBox MaxHeight="160" ItemsSource="{Binding UnusedImages}" SelectedItem="{Binding SelectedUnusedImage}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="themes:ExtraAsset">
                          <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Column="1" Margin="8,0,0,0" Height="96" VerticalAlignment="Top" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                      <controls:FileImage Margin="4" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" FilePath="{Binding SelectedUnusedImage.ImagePath}" />
                    </Border>
                  </Grid>
                  <Button Padding="10,6" HorizontalAlignment="Stretch" Command="{Binding DeleteUnusedImageCommand}" Content="Delete selected image from the theme" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Bottom Status Bar -->
    <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource HeaderBackgroundBrush}">
      <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource HeaderMutedBrush}" Text="{Binding Status}" />
    </Border>
  </Grid>
</Window>
