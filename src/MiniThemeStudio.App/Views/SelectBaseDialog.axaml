<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="using:MiniThemeStudio.App.Controls" x:Class="MiniThemeStudio.App.Views.SelectBaseDialog" Title="Select Base" Width="480" Height="300" CanResize="False" ShowInTaskbar="False" SystemDecorations="None" TransparencyLevelHint="Transparent" WindowStartupLocation="CenterOwner" Background="Transparent" FontFamily="Segoe UI, Ubuntu, sans-serif">
  <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="28">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock FontFamily="Georgia, serif" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Theme console" />
      <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
      <controls:BaseSelector x:Name="BaseSelector" Grid.Row="2" Margin="0,18,0,0" />
      <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
        <Button Padding="16,8" Click="Cancel_Click" Content="Cancel" />
        <Button Padding="16,8" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Click="Use_Click" Content="Use this Base" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
