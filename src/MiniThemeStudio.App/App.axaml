<Application xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MiniThemeStudio.App.App"
  xmlns:local="using:MiniThemeStudio.App"
  xmlns:lucide="using:Lucide.Avalonia" RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Type scale -->
      <x:Double x:Key="FontSizeCaption">11</x:Double>
      <x:Double x:Key="FontSizeSmall">12</x:Double>
      <x:Double x:Key="FontSizeSubtitle">16</x:Double>
      <x:Double x:Key="FontSizeTitle">18</x:Double>
      <x:Double x:Key="FontSizeHeading">24</x:Double>
      <x:Double x:Key="FontSizeDisplay">32</x:Double>

      <!-- Checkerboard behind a preview, to see the transparent parts of an image -->
      <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" DestinationRect="0,0,16,16">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="#2B2F33" Geometry="M0,0 H16 V16 H0 Z" />
            <GeometryDrawing Brush="#3A3F44" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>

      <!-- Section tab: underlined when checked -->
      <ControlTheme x:Key="SectionTabTheme" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource HeaderMutedBrush}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Part" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Part">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Part">
          <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
        </Style>
      </ControlTheme>

      <!-- Segment of a sub-navigation: filled when checked -->
      <ControlTheme x:Key="SegmentTheme" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource HeaderMutedBrush}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border Name="Part" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" /></Border>
          </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
          <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
        </Style>
        <Style Selector="^:checked">
          <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#Part">
          <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#Part">
          <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
      </ControlTheme>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <Color x:Key="SystemAccentColor">#C99A18</Color>
          <Color x:Key="SystemAccentColorDark1">#B98B12</Color>
          <Color x:Key="SystemAccentColorDark2">#A67B0E</Color>
          <Color x:Key="SystemAccentColorDark3">#8E680A</Color>
          <Color x:Key="SystemAccentColorLight1">#D5A92D</Color>
          <Color x:Key="SystemAccentColorLight2">#E1BA52</Color>
          <Color x:Key="SystemAccentColorLight3">#EACB79</Color>
          <SolidColorBrush x:Key="PageBackgroundBrush">#F5F5F4</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBackgroundBrush">#F0F0EE</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBorderBrush">#D7D7D4</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderTextBrush">#202124</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderMutedBrush">#62656A</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#C99A18</SolidColorBrush>
          <SolidColorBrush x:Key="AccentTextBrush">#171717</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackgroundBrush">#EEEEEC</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarSelectedBrush">#E3E3E0</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackgroundBrush">#F8F8F7</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBackgroundBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush">#D7D7D4</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryTextBrush">#202124</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryTextBrush">#62656A</SolidColorBrush>
          <SolidColorBrush x:Key="PreviewBackgroundBrush">#D4D4D1</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorTextBrush">#A23A32</SolidColorBrush>
          <SolidColorBrush x:Key="DialogDefaultBrush">#68716C</SolidColorBrush>
          <SolidColorBrush x:Key="DialogInfoBrush">#2B77C0</SolidColorBrush>
          <SolidColorBrush x:Key="DialogSuccessBrush">#2D7D46</SolidColorBrush>
          <SolidColorBrush x:Key="DialogWarningBrush">#B7791F</SolidColorBrush>
          <SolidColorBrush x:Key="DialogErrorBrush">#C73E3A</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="SystemAccentColor">#E6B832</Color>
          <Color x:Key="SystemAccentColorDark1">#CFA72F</Color>
          <Color x:Key="SystemAccentColorDark2">#B89121</Color>
          <Color x:Key="SystemAccentColorDark3">#9D7918</Color>
          <Color x:Key="SystemAccentColorLight1">#E8C65F</Color>
          <Color x:Key="SystemAccentColorLight2">#EFD47F</Color>
          <Color x:Key="SystemAccentColorLight3">#F5E1A5</Color>
          <SolidColorBrush x:Key="PageBackgroundBrush">#151719</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBackgroundBrush">#202326</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderBorderBrush">#2F3438</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderTextBrush">#F2F2F3</SolidColorBrush>
          <SolidColorBrush x:Key="HeaderMutedBrush">#A8A8AD</SolidColorBrush>
          <SolidColorBrush x:Key="AccentBrush">#E6B832</SolidColorBrush>
          <SolidColorBrush x:Key="AccentTextBrush">#151515</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBackgroundBrush">#202326</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarSelectedBrush">#292D31</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackgroundBrush">#1B1E20</SolidColorBrush>
          <SolidColorBrush x:Key="SurfaceBackgroundBrush">#202326</SolidColorBrush>
          <SolidColorBrush x:Key="BorderBrush">#2F3438</SolidColorBrush>
          <SolidColorBrush x:Key="PrimaryTextBrush">#F0F0F2</SolidColorBrush>
          <SolidColorBrush x:Key="SecondaryTextBrush">#ABABB0</SolidColorBrush>
          <SolidColorBrush x:Key="PreviewBackgroundBrush">#74767A</SolidColorBrush>
          <SolidColorBrush x:Key="ErrorTextBrush">#FF8A80</SolidColorBrush>
          <SolidColorBrush x:Key="DialogDefaultBrush">#ABABB0</SolidColorBrush>
          <SolidColorBrush x:Key="DialogInfoBrush">#63B3FF</SolidColorBrush>
          <SolidColorBrush x:Key="DialogSuccessBrush">#5FD28A</SolidColorBrush>
          <SolidColorBrush x:Key="DialogWarningBrush">#F6C453</SolidColorBrush>
          <SolidColorBrush x:Key="DialogErrorBrush">#FF756D</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <!-- Surface of an image preview; Border.checker draws the checkerboard instead -->
    <Style Selector="Border.preview">
      <Setter Property="Background" Value="{DynamicResource PreviewBackgroundBrush}" />
    </Style>
    <Style Selector="Border.preview.checker">
      <Setter Property="Background" Value="{StaticResource CheckerboardBrush}" />
    </Style>
    <!-- Panel with a border: the surface for cards and lists -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <!-- Button hierarchy: Button.primary is the single main action, Button.ghost is for secondary actions -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight1}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <!-- Sidebar button; Button.nav.active is the section being shown -->
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
    </Style>
    <Style Selector="Button.nav lucide|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource HeaderMutedBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover lucide|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource HeaderTextBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
    </Style>
    <Style Selector="Button.nav.active lucide|LucideIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HeaderMutedBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SidebarSelectedBrush}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource HeaderTextBrush}" />
    </Style>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  </Application.Styles>
</Application>
