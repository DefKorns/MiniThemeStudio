<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MiniThemeStudio.App.Views.ConsoleConnectionDialog" Title="Console connection" Width="440" Height="190" CanResize="False" ShowInTaskbar="False" SystemDecorations="None" TransparencyLevelHint="Transparent" WindowStartupLocation="CenterOwner" Background="Transparent" FontFamily="Segoe UI, Ubuntu, sans-serif">
  <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="28">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock FontFamily="Georgia, serif" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Connecting to console" />
      <TextBlock Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryTextBrush}" Text="Establishing a connection and locating the original Base UI." TextWrapping="Wrap" />
      <ProgressBar Grid.Row="2" Margin="0,20,0,0" Height="6" IsIndeterminate="True" />
      <Button Grid.Row="3" Margin="0,18,0,0" Padding="14,7" HorizontalAlignment="Right" Click="Cancel_Click" Content="Cancel" />
    </Grid>
  </Border>
</Window>
