<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:MiniThemeStudio.App.Controls"
        x:Class="MiniThemeStudio.App.Views.SpriteSheetDialog"
        Title="Import frames from a sprite sheet"
        Width="1100" Height="760" MinWidth="800" MinHeight="520"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI, Ubuntu, sans-serif">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="20">
    <StackPanel Spacing="4">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Import frames from a sprite sheet" />
      <TextBlock x:Name="HintText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="Open a sheet, mark every background colour as transparent, then click the frames in playback order." />
    </StackPanel>

    <WrapPanel Grid.Row="1" Margin="0,14,0,10" ItemSpacing="8" LineSpacing="8">
      <Button Padding="12,6" Click="OpenSheet_Click" Content="Open sheet..." />
      <ToggleButton x:Name="PickColourButton" Padding="12,6" Content="Pick background colour" IsEnabled="False" />
      <StackPanel x:Name="ColourChips" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
      <Button x:Name="ClearColoursButton" Padding="10,6" Click="ClearColours_Click" Content="Clear colours" IsEnabled="False" />
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Tolerance" />
        <NumericUpDown x:Name="ToleranceBox" Width="110" Minimum="0" Maximum="64" Value="8" Increment="2" FormatString="0" ValueChanged="Tolerance_ValueChanged" />
      </StackPanel>
      <Button x:Name="ClearSelectionButton" Padding="10,6" Click="ClearSelection_Click" Content="Clear selection" IsEnabled="False" />
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Padding="6,2" Content="1x" Click="Zoom1x_Click" />
        <Button Padding="6,2" Content="2x" Click="Zoom2x_Click" />
        <Button Padding="6,2" Content="3x" Click="Zoom3x_Click" />
      </StackPanel>
    </WrapPanel>

    <Grid Grid.Row="2" ColumnDefinitions="*,240">
      <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <controls:AtlasView x:Name="SheetCanvas" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" />
        </ScrollViewer>
      </Border>

      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8">
        <TextBlock FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Text="Running direction" />
        <ComboBox x:Name="DirectionComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
          <ComboBoxItem Content="Sheet runs right → left" />
          <ComboBoxItem Content="Sheet runs left → right" />
        </ComboBox>
        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="Frames run right → left like the current frame; the console flips the character itself when it turns. Left → right sheets are flipped on import." />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Spacing="4">
            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Current" />
            <Border Height="150" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
              <Image x:Name="ReferenceImage" Margin="6" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Text="Imported" />
            <Border Height="150" Background="{DynamicResource PreviewBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
              <Viewbox Margin="6" StretchDirection="DownOnly">
                <Grid x:Name="ImportPreviewCanvas">
                  <Image x:Name="ImportPreviewImage" HorizontalAlignment="Center" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None" />
                </Grid>
              </Viewbox>
            </Border>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="3" Margin="0,14,0,0" ColumnDefinitions="*,Auto,Auto,Auto">
      <TextBlock x:Name="SelectionText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Text="No sheet open." />
      <ComboBox x:Name="AnchorComboBox" Grid.Column="1" Margin="12,0" SelectedIndex="0" VerticalAlignment="Center">
        <ComboBoxItem Content="Align by the feet" />
        <ComboBoxItem Content="Align centred" />
      </ComboBox>
      <Button Grid.Column="2" Margin="0,0,8,0" Padding="16,8" Click="Cancel_Click" Content="Cancel" />
      <Button x:Name="UseFramesButton" Grid.Column="3" Padding="16,8" IsEnabled="False" Click="UseFrames_Click"
              Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" Content="Use frames" />
    </Grid>
  </Grid>
</Window>
