<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:firmware="using:MiniThemeStudio.Core.Firmware"
        xmlns:lucide="using:Lucide.Avalonia"
        x:Class="MiniThemeStudio.App.Views.BaseManagementDialog"
        Title="Base Firmware Management"
        Width="860" Height="620"
        MinWidth="720" MinHeight="500"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBackgroundBrush}"
        FontFamily="Segoe UI, Ubuntu, sans-serif">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Text="Base Firmware Management" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Text="Original Base UIs are verified by SHA-256 before they are installed. Provide your own firmware files; none are bundled."
                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
      </StackPanel>
      <Button Grid.Column="1" Click="Refresh_Click" Background="Transparent" ToolTip.Tip="Refresh installed bases">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <lucide:LucideIcon Kind="RotateCcw" Size="16" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
    </Grid>

    <Border Grid.Row="1" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
      <ListBox x:Name="BasesListBox" Margin="8" SelectionMode="Single">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="firmware:InstalledBaseInfo">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,2">
              <Border Width="64" Height="36" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="4" Margin="0,0,12,0">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"
                           Text="{Binding Definition.Console}" />
              </Border>

              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding Definition.DisplayName}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Definition.FirmwareVersionsText, StringFormat='Firmware versions: {0}'}" />
                <TextBlock FontSize="12" Foreground="{DynamicResource ErrorTextBrush}" Text="{Binding Problem}"
                           IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>

              <TextBlock Grid.Column="2" Margin="16,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                         Text="{Binding Definition.Version, StringFormat='v{0}'}" Foreground="{DynamicResource SecondaryTextBrush}" />

              <Border Grid.Column="3" VerticalAlignment="Center" Padding="8,4" CornerRadius="4"
                      Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding Status}" />
              </Border>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
      <StackPanel x:Name="ImportButtons" Orientation="Horizontal" Spacing="8">
        <Button Click="ImportFile_Click" Padding="14,8" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="Archive" Size="16" />
            <TextBlock Text="Import file (.hsqs / .tar.gz)" />
          </StackPanel>
        </Button>
        <Button Click="ImportFolder_Click" Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="FolderOpen" Size="16" />
            <TextBlock Text="Import folder" />
          </StackPanel>
        </Button>
        <Button Click="ImportConsole_Click" Padding="14,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <lucide:LucideIcon Kind="Download" Size="16" />
            <TextBlock Text="From console" />
          </StackPanel>
        </Button>
      </StackPanel>

      <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />

      <Button Grid.Column="2" Click="Close_Click" Padding="16,8" Content="Close" />
    </Grid>
  </Grid>
</Window>
